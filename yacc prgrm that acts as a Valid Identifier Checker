%{ 
#include <stdio.h> 
#include <ctype.h> 
int yylex(void); 
void yyerror(const char *s); 
%} 
%token LETTER DIGIT 
%% 
input: LETTER tail { printf("Valid Identifier\n"); return 0; } ; 
tail:  tail LETTER 
| tail DIGIT 
| /* empty */ 
; 
%% 
int yylex(void) { 
int c = getchar(); 
if (c == '\n' || c == EOF) return 0; 
if (isalpha(c)) return LETTER; 
if (isdigit(c)) return DIGIT; 
return c;  
} 
void yyerror(const char *s) { 
printf("Invalid Identifier\n"); 
} 
int main(void) { 
printf("Enter identifier: "); 
yyparse(); 
return 0; 
} 
