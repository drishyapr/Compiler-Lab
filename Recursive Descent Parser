#include <stdio.h>
char s[100];
int p=0,e=0;

void E(); void E1(); void T(); void T1(); void F();

void E(){ T(); E1(); }
void E1(){ if(s[p]=='+'){ p++; T(); E1(); } }
void T(){ F(); T1(); }
void T1(){ if(s[p]=='*'){ p++; F(); T1(); } }

void F(){
    if(s[p]=='('){
        p++; E();
        if(s[p]==')') p++;
        else e=1;
    }
    else if(s[p]=='i') p++;
    else e=1;
}

int main(){
    printf("Enter input: ");
    scanf("%99s",s);
    E();
    if(!e && s[p]=='\0') printf("String Accepted");
    else printf("String Rejected");
    return 0;
}
