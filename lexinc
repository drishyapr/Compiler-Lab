#include <stdio.h>
#include <ctype.h>
#include <string.h>

char *kw[]={"int","float","char","if","else","while","for","return","void","break","continue","double","long","short","switch","case","default","do"};

int main() {
    FILE *f=fopen("input.c","r");
    int c,n,i,k; char b[100];
    if(!f) return 1;

    while((c=fgetc(f))!=EOF) {
        if(isspace(c)) continue;

        if(c=='/') {
            n=fgetc(f);
            if(n=='/' || n=='*') {
                if(n=='/') while((c=fgetc(f))!='\n'&&c!=EOF);
                else while((c=fgetc(f))!=EOF)
                    if(c=='*'&&(c=fgetc(f))=='/') break;
                continue;
            }
            ungetc(n,f);
        }

        if(isalpha(c)||c=='_') {
            i=0; b[i++]=c;
            while((c=fgetc(f))!=EOF&&(isalnum(c)||c=='_')) b[i++]=c;
            b[i]=0; if(c!=EOF) ungetc(c,f);
            k=0;
            for(i=0;i<18;i++) if(!strcmp(b,kw[i])) k=1;
            printf("%s : %s\n",k?"Keyword":"Identifier",b);
        }
        else if(isdigit(c)) {
            i=0; b[i++]=c;
            while((c=fgetc(f))!=EOF&&(isdigit(c)||c=='.')) b[i++]=c;
            b[i]=0; if(c!=EOF) ungetc(c,f);
            printf("Number : %s\n",b);
        }
        else if(strchr("+-*/%=<>!&|",c))
            printf("Operator : %c\n",c);
        else if(strchr("(){}[];,.",c))
            printf("Special Symbol : %c\n",c);
    }
    fclose(f);
}
